{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "release/v*",
    "requireCommits": true,
    "tag": false,
    "push": false
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": "pnpm release:check",
    "after:bump": "pnpm install --lockfile-only && test \"$(git branch --show-current)\" = \"release/v${version}\"",
    "after:release": "echo Prepared release PR commit for ${name} v${version}"
  }
}
