{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "master",
    "requireCommits": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "Release v${version}",
    "autoGenerate": true
  },
  "hooks": {
    "before:init": "pnpm release:check",
    "after:git:release": "npm publish --access public"
  }
}
